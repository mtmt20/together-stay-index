# Together-Stay Index 전용 환경변수 템플릿.
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용한다 (.env는 git에 커밋 금지).
#
# 중요: 아래 버킷명/DB명은 기존에 돌고 있는 다른 프로젝트(위스키 파이프라인 등)
# 와 절대 겹치지 않는 "이 프로젝트 전용" 이름으로 새로 만들어서 채울 것.
# 기존 버킷/DB를 재사용하면 데이터가 섞이거나 권한 반경이 넓어져 위험하다.

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API 사용 설정 후 발급
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 프로젝트 전용으로 새로 만든 S3 버킷 (기존 프로젝트 버킷 재사용 금지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=together-stay-index-bronze
AWS_REGION=ap-northeast-2

# 2026-09-18: Snowflake -> DuckDB 이전. DuckDB는 파일 기반이라 계정/비밀번호/
# 웨어하우스가 필요 없다 (docker-compose.yml이 DUCKDB_PATH를 이미 고정값으로
# 넣어뒀음). Streamlit Community Cloud에 배포할 때만 위의 AWS_* 값을
# 대시보드 설정(secrets)에 그대로 붙여넣으면 된다 - S3에 올려둔 최신
# .duckdb 스냅샷을 내려받는 용도.
