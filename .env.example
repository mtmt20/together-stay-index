# Together-Stay Index 전용 환경변수 템플릿.
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용한다 (.env는 git에 커밋 금지).
#
# 중요: 아래 버킷명/DB명은 기존에 돌고 있는 다른 프로젝트(위스키 파이프라인 등)
# 와 절대 겹치지 않는 "이 프로젝트 전용" 이름으로 새로 만들어서 채울 것.
# 기존 버킷/DB를 재사용하면 데이터가 섞이거나 권한 반경이 넓어져 위험하다.

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API 사용 설정 후 발급
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 프로젝트 전용으로 새로 만든 S3 버킷 (기존 프로젝트 버킷 재사용 금지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=together-stay-index-bronze

# Airflow의 COPY INTO 태스크는 Airflow Connection(UI, conn id:
# together_stay_snowflake)으로 별도 등록한다. Admin > Connections 에서:
#   Conn Type: Snowflake
#   Login / Password / Account / Warehouse / Database(TOGETHER_STAY_DB) / Schema(RAW)
# 를 입력해 등록할 것.
#
# 아래 SNOWFLAKE_* 는 Streamlit 대시보드(tsi-streamlit)와 dbt 컨테이너
# (tsi-dbt)가 직접 접속할 때 쓴다. 위 Airflow Connection과 같은 계정 정보를
# 넣으면 되지만, DB는 반드시 TOGETHER_STAY_DB로 고정할 것.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=
