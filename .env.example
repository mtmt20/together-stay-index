# Together-Stay Index 전용 환경변수 템플릿.
# 실제 값을 채운 뒤 파일명을 .env 로 바꿔서 사용한다 (.env는 git에 커밋 금지).
#
# 중요: 아래 버킷명/DB명은 기존에 돌고 있는 다른 프로젝트(위스키 파이프라인 등)
# 와 절대 겹치지 않는 "이 프로젝트 전용" 이름으로 새로 만들어서 채울 것.
# 기존 버킷/DB를 재사용하면 데이터가 섞이거나 권한 반경이 넓어져 위험하다.

# 네이버 개발자센터 > 애플리케이션 등록 > 검색 API 사용 설정 후 발급
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이 프로젝트 전용으로 새로 만든 S3 버킷 (기존 프로젝트 버킷 재사용 금지)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=together-stay-index-bronze

# Snowflake는 위스키 파이프라인과 같은 계정(svgjcjl-uh88149, user mtmt20)을
# 재사용하되, 인증키는 공유하지 않고 이 프로젝트 전용으로 새로 발급했다
# (같은 유저에 RSA_PUBLIC_KEY_2로 두 번째 키 등록 - secrets/README 참고).
# 계정/유저/역할/웨어하우스 기본값은 docker-compose.yml에 이미 박아뒀으므로
# (SNOWFLAKE_ACCOUNT 기본값 svgjcjl-uh88149, USER 기본값 mtmt20, WAREHOUSE
# 기본값 WHISKY_WH 재사용, ROLE 기본값 ACCOUNTADMIN) 보통은 여기 안 채워도
# 된다. 다른 웨어하우스/역할을 쓰고 싶을 때만 아래를 채워서 기본값을
# 덮어쓰면 된다. 비밀번호는 필요 없다(키페어 인증).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
